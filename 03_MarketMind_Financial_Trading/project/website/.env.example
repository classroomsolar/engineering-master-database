# Set these as SECRET environment variables on your chosen hosting platform.
# DO NOT PUT REAL VALUES IN THIS FILE OR COMMIT ANY CREDENTIALS.
APP_USERNAME=REPLACE_WITH_OWNER_USERNAME
APP_PASSWORD=REPLACE_WITH_12_PLUS_CHARACTER_RANDOM_PASSWORD
SESSION_SECRET=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
# Use an HTTPS URL after deploying. HTTPS is required for private real-world access.
PUBLIC_BASE_URL=https://your-private-website.example
HOST=0.0.0.0
PORT=3000
